# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Google Gemini API key from aistudio.google.com (required for AI evaluation)
GEMINI_API_KEY=

# Telegram numeric user ID of the administrator (required)
ADMIN_ID=

# Path to the SQLite database file
DATABASE_PATH=cefr_bot.db

# Gemini model name (can be changed when Google updates model names)
GEMINI_MODEL=gemini-2.5-flash

# Seconds to wait for one Gemini response
GEMINI_TIMEOUT_SECONDS=90

# Number of retries after a temporary Gemini error (rate limit, connection)
GEMINI_MAX_RETRIES=2

# Maximum number of characters accepted in one submission
MAX_WRITING_CHARS=4000

# Minimum number of words in one submission
MIN_WRITING_WORDS=5

# Estimated practice rubric scale (NOT an official national rubric)
DIMENSION_MAX_SCORE=5
OVERALL_MAX_SCORE=100

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
